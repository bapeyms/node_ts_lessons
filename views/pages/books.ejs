<ul style="
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;">

    <% books.forEach(book => { %>
        <li style="
            background: #e8d8c3;
            border: 1px solid #cdb69d;
            border-radius: 14px;
            padding: 16px;
            width: 240px;
            box-shadow: 0 5px 15px rgba(70, 48, 30, 0.10);
            display: flex;
            flex-direction: column;
            gap: 14px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;"
            onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 9px 20px rgba(70, 48, 30, 0.16)'"
            onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 5px 15px rgba(70, 48, 30, 0.10)'">

            <div>
                <h3 style="
                    margin: 0 0 7px 0;
                    font-family: Georgia, 'Times New Roman', serif;
                    font-size: 1.15rem;
                    font-weight: normal;
                    color: #3f3026;
                    line-height: 1.3;">
                    <%= book.title %>
                </h3>

                <span style="
                    display: block;
                    margin-bottom: 12px;
                    font-size: 1rem;
                    font-weight: bold;
                    color: #7a563d;">
                    <%= book.price %> ₴
                </span>

                <button class="delete-btn"
                data-id="<%= book.id %>"
                style="
                    background: #a98263;
                    border: 1px solid #8f6b50;
                    border-radius: 7px;
                    padding: 7px 13px;
                    color: #fffaf4;
                    font-size: 0.85rem;
                    font-weight: 500;
                    cursor: pointer;">
                    Видалити
                </button>

            </div>

            <div style="
                width: 100%;
                height: 220px;
                border-radius: 10px;
                overflow: hidden;
                background-color: #f4eee5;
                border: 1px solid #d6c1aa;">

                <% let imgName = Array.isArray(book.image) ? book.image[0] : book.image;
                   let imgSrc = (imgName && typeof imgName === 'string') ? '/imgs/' + imgName : '/imgs/default.png'; %>

                <img
                    src="<%= imgSrc %>"
                    alt="<%= book.title %>"
                    style="
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        display: block;">
            </div>
        </li>
    <% }) %>
</ul>

<script>
    // пошук усіх кнопок видалення за класом
    document.querySelectorAll('.delete-btn').forEach(button => {
        button.addEventListener('click', async (e) => {
            const bookId = e.target.getAttribute('data-id');

            if (confirm("Ви дійсно хочете видалити цю книгу?")) {
                try {
                    const response = await fetch(`/books/${bookId}`, {
                        method: 'DELETE'
                    });

                    if (response.ok) {
                        window.location.href = '/books';
                    } else {
                        alert("Не вдалося видалити книгу");
                    }
                } catch (error) {
                    console.error("Помилка при видаленні:", error);
                }
            }
        });
    });
</script>