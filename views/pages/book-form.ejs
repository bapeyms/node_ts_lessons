<style>
    .book-form-wrapper {
        max-width: 650px;
        margin: 20px auto;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 20px;
        color: #fffaf4;
        background: #79583f;
        text-decoration: none;
        font-weight: 500;
        padding: 10px 17px;
        border-radius: 8px;
        transition: 0.2s ease;
    }

    .back-link:hover {
        background: #5f4532;
        color: #fffaf4;
        transform: translateY(-2px);
    }

    .book-form {
        width: 100%;
        padding: 30px;
        background: #e8d8c3;
        border: 1px solid #cdb69d;
        border-radius: 16px;
        box-shadow: 0 6px 20px rgba(70, 48, 30, 0.10);
    }

    .book-form-title {
        margin: 0 0 25px 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.8rem;
        font-weight: normal;
        letter-spacing: 1px;
        color: #3f3026;
    }

    .book-form .form-label {
        color: #4d392c;
        font-weight: 500;
        margin-bottom: 7px;
    }

    .book-form .form-control {
        background: #f8f3ec;
        border: 1px solid #cdb69d;
        border-radius: 8px;
        color: #3f3026;
        padding: 10px 12px;
    }

    .book-form .form-control:focus {
        background: #fffaf4;
        border-color: #9a7658;
        box-shadow: 0 0 0 3px rgba(154, 118, 88, 0.15);
        color: #3f3026;
    }

    .book-form .form-check {
        margin-top: 5px;
    }

    .book-form .form-check-input {
        background-color: #f8f3ec;
        border-color: #b99d80;
    }

    .book-form .form-check-input:checked {
        background-color: #79583f;
        border-color: #79583f;
    }

    .book-form .form-check-label {
        color: #4d392c;
    }

    .book-form .btn-add {
        margin-top: 10px;
        background: #79583f;
        border: 1px solid #79583f;
        border-radius: 8px;
        padding: 10px 22px;
        color: #fffaf4;
        font-weight: 500;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .book-form .btn-add:hover {
        background: #5f4532;
        border-color: #5f4532;
        transform: translateY(-1px);
    }
</style>


<div class="book-form-wrapper">
    <a class="back-link" href="/books">← Назад до списку книг</a>

    <form
        method="POST"
        action="/books/add-book"
        enctype="multipart/form-data"
        class="book-form">
        <h2 class="book-form-title">Add a new book</h2>

        <div class="mb-3">
            <label for="inputTitle" class="form-label">Title</label>
            <input
                type="text"
                name="title"
                class="form-control"
                id="inputTitle"
                placeholder="Enter book title">
        </div>

        <div class="mb-3">
            <label for="inputPrice" class="form-label">Price</label>
            <input
                type="text"
                name="price"
                class="form-control"
                id="inputPrice"
                placeholder="Enter price">
        </div>

        <div class="mb-3 form-check">
            <input
                type="checkbox"
                checked
                name="isActive"
                value="true"
                class="form-check-input"
                id="exampleCheck1">
            <label
                class="form-check-label"
                for="exampleCheck1">Is active</label>
        </div>

        <div class="mb-3">
            <label for="inputYear" class="form-label">Year</label>
            <input
                type="number"
                name="year"
                class="form-control"
                id="inputYear"
                placeholder="Enter publication year">
        </div>

        <div class="mb-3">
            <label for="inputImage" class="form-label">Image</label>
            <input
                type="file"
                name="image"
                class="form-control"
                id="inputImage"
                accept="image/*">
        </div>

        <button type="submit" class="btn btn-add">
            Add Book
        </button>
    </form>
</div>