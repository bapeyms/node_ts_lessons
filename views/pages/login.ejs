<div style="max-width: 380px; margin: 40px auto;">
    <div style="
        background: #e8d8c3; 
        border: 1px solid #cdb69d; 
        border-radius: 14px; 
        padding: 24px; 
        box-shadow: 0 5px 15px rgba(70, 48, 30, 0.10);">
        
        <h3 style="
            text-align: center; 
            margin-top: 0; 
            margin-bottom: 20px; 
            color: #3f3026; 
            font-family: Georgia, serif;">
            Вхід на сайт
        </h3>

        <% if (typeof error !== 'undefined') { %>
            <div class="alert alert-danger" style="padding: 8px 12px; font-size: 0.9rem; margin-bottom: 16px;">
                <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
            <div>
                <label for="username" class="form-label" style="color: #3f3026; font-weight: 500;">Ім'я користувача</label>
                <input type="text" id="username" name="username" class="form-control" placeholder="Введіть ваш логін" required>
            </div>

            <button type="submit" class="btn" style="
                background: #a98263; 
                border: 1px solid #8f6b50; 
                color: #fffaf4; 
                padding: 8px; 
                font-weight: 500; 
                border-radius: 7px; 
                cursor: pointer; 
                margin-top: 8px;">
                Увійти
            </button>
        </form>
    </div>
</div>