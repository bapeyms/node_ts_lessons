<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f4eee5;
        color: #3f3026;
        font-family: Arial, sans-serif;
    }

    .header {
        background: #e4d3bc;
        color: #3f3026;
        padding: 22px 45px;
        margin-bottom: 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #c7ad91;
        box-shadow: 0 5px 18px rgba(70, 48, 30, 0.12);
    }

    .logo {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.9rem;
        font-weight: normal;
        letter-spacing: 3px;
        color: #3b2b21;
    }

    .nav {
        display: flex;
        align-items: center;
        gap: 30px;
    }

    .nav a {
        position: relative;
        color: #4d392c;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.5px;
        padding: 8px 0;
        transition: color 0.25s ease;
    }

    .nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 0;
        height: 1px;
        background: #8a6549;
        transition: width 0.25s ease;
    }

    .nav a:hover {
        color: #8a6549;
    }

    .nav a:hover::after {
        width: 100%;
    }
</style>

<header class="header">
    <h1 class="logo">BRAT LIBRARY</h1>
    <span>Welcome, <%= username %></span>
    <nav class="nav">
        <a href="/books">Book Catalog</a>
        <a href="/books/add-book">Add Book</a>
        <a href="/">Home</a>
    </nav>
</header>