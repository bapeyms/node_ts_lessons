<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f4eee5;
        color: #3f3026;
        font-family: Arial, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
    }

    .footer {
        background: #e4d3bc;
        color: #3f3026;
        padding: 25px 45px;
        margin-top: 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #c7ad91;
        box-shadow: 0 -5px 18px rgba(70, 48, 30, 0.10);
    }

    .footer-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.3rem;
        font-weight: normal;
        letter-spacing: 2px;
        color: #3b2b21;
    }

    .footer-copy {
        margin: 7px 0 0 0;
        font-size: 0.85rem;
        color: #735b48;
    }

    .footer-nav {
        display: flex;
        gap: 30px;
    }

    .footer-nav a {
        position: relative;
        color: #4d392c;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.4px;
        padding: 8px 0;
        transition: color 0.25s ease;
    }

    .footer-nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 0;
        height: 1px;
        background: #8a6549;
        transition: width 0.25s ease;
    }

    .footer-nav a:hover {
        color: #8a6549;
    }

    .footer-nav a:hover::after {
        width: 100%;
    }

    @media (max-width: 600px) {
        .footer {
            flex-direction: column;
            gap: 20px;
            text-align: center;
        }

        .footer-nav {
            gap: 20px;
        }
    }
</style>

<footer class="footer">
    <div>
        <h3 class="footer-title">BRAT LIBRARY</h3>
        <p class="footer-copy">© 2026 All rights reserved</p>
    </div>

    <nav class="footer-nav">
        <a href="/books">Book Catalog</a>
        <a href="/books/add-book">Add Book</a>
        <a href="/">Home</a>
    </nav>
</footer>